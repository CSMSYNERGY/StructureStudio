// Cloudflare Worker config — PRODUCTION frontend, LIVE at app.structurestudiosuite.com
// (zone route `app.structurestudiosuite.com/*` → this worker, created 2026-08-05; routes are
// dashboard/API-managed during the migration ON PURPOSE — see the note at the bottom).
// DEPLOYS ARE GIT-DRIVEN: Workers Builds deploys this worker from `main` on push. The repo
// was connected 2026-08-06 — before that the 08-05 Builds setup had landed on the BETA worker
// twice and this one had NO git connection (zero builds ever), which is why early main merges
// shipped via a manual detached-LF-worktree `npx wrangler deploy` (CRLF checkouts break
// byte-parity). Manual path = fallback only. History: npx wrangler deployments list --name
// structurestudio-app. LEGACY: structurestudio.app is now a permanent 301 redirect to this
// host (worker `structurestudio-sunset-redirect`); Netlify builds stopped 2026-08-06.
// Beta twin: wrangler.beta.jsonc (structurestudio-beta). Assets-only Worker:
// no "main" script, no bindings, no vars — this repo is PUBLIC, so nothing secret may ever
// be added here (worker name + account_id are non-secret identifiers).
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "structurestudio-app",
  "compatibility_date": "2026-08-05",
  "account_id": "7e50b16eb8fa53548348c37dbd71df00",
  "assets": {
    "directory": ".",
    // "none" is load-bearing: the default (auto-trailing-slash) 307-redirects
    // /offline.html -> /offline, and sw.js caches /offline.html at install — a cached
    // redirected response makes Chrome fail the offline navigation for every installed
    // PWA. "none" serves every .html file as-is (what Netlify did); _redirects supplies
    // the / -> /index.html mapping that "none" drops.
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
  // NO "routes" here until the migration reaches steady state: during cutover the zone
  // routes are dashboard-managed rollback levers, and a route listed here would be
  // re-created by the next git deploy right after an operator deleted it mid-incident.
}
