// Cloudflare Worker config — BETA frontend, live at beta.structurestudiosuite.com.
// DEPLOYS ARE GIT-DRIVEN: Workers Builds deploys this worker on every push to `beta`
// (connected + verified end-to-end 2026-08-05: push → live in ~2 min, byte-identical to git).
// Manual fallback only if Builds is down: npx wrangler deploy --config wrangler.beta.jsonc
// Verify any deploy with: npx wrangler deployments list --name structurestudio-beta
// (beta.structurestudio.app still resolves, but that is the STALE Netlify copy — the
// migration moved beta to the structurestudiosuite.com domain; don't verify against it.)
// Identical to wrangler.jsonc except the worker name; see that file for the reasoning
// behind every setting (html_handling "none" is load-bearing — read before changing).
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "structurestudio-beta",
  "compatibility_date": "2026-08-05",
  "account_id": "7e50b16eb8fa53548348c37dbd71df00",
  "assets": {
    "directory": ".",
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
}
